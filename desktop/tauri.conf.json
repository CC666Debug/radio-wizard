{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadioWizard",
  "mainBinaryName": "radio-wizard",
  "version": "1.21.1",
  "identifier": "io.github.cc666debug.radiowizard",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Find any radio station, play your Bandcamp, cast to speakers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
